# Firebase コンソール →「プロジェクトの設定」→「マイアプリ」のウェブアプリの firebaseConfig の値
# ローカルでは .env.local にコピーして値を入れる（.env.local は git に入りません）
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# 1 にするとローカルの Firebase エミュレータ（auth:9099 / firestore:8080）につなぐ（開発・テスト用）
EXPO_PUBLIC_FIREBASE_EMULATOR=
